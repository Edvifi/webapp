# Copy to .env.local for development. Vite only ships VITE_* vars to the browser.

# Supabase project (Settings → API). The anon key is public by design; RLS protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature flags — off unless set to true/1/yes/on. Fixed at build time.
# AI essay feedback (Essays module → Drafts → "Get feedback"). Needs the
# essay-feedback edge function deployed with ANTHROPIC_API_KEY set.
VITE_FEATURE_ESSAY_FEEDBACK=false
