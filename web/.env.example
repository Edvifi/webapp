# Copy to .env.local and fill in. Everything here is bundled into the client at
# build time (that is what the VITE_ prefix means), so never put a secret or a
# service-role key in this file.

# --- Supabase (required) -----------------------------------------------------
# Project URL and anon/public key. The anon key is safe to ship: it is
# row-level-security scoped and is meant to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- logo.dev (optional) -----------------------------------------------------
# Publishable token for school logos on the Discover / College List cards
# (web/src/lib/collegeLogo.ts). Without it, logoUrlForDomain() returns null and
# the UI falls back to its emoji glyph — no errors, just no logos.
#
# Privacy note: logos are fetched from img.logo.dev per card, so logo.dev
# receives the domains of the schools a student browses, along with their IP.
# Self-host or proxy the images if that is not acceptable.
VITE_LOGODEV_TOKEN=

# --- Feature flags (optional) ------------------------------------------------
# Off unless set to true/1/yes/on, and fixed at build time — flipping one means
# changing the host's env and rebuilding. See web/src/lib/featureFlags.ts.
#
# AI essay feedback (Essays module → Drafts → "Get feedback"). Also needs the
# essay-feedback edge function deployed with ANTHROPIC_API_KEY set; see
# supabase/functions/essay-feedback/README.md.

# --- Cloudflare Turnstile (optional) -----------------------------------------
# Site key for the CAPTCHA on sign-up, sign-in and password reset. Leave unset
# and no widget renders and no token is sent — which is what CAPTCHA being
# DISABLED in Supabase Auth expects.
#
# These two must be turned on together. Setting this key while Supabase has
# CAPTCHA off is harmless; enabling CAPTCHA in Supabase without this key makes
# every auth call fail.
VITE_TURNSTILE_SITE_KEY=
